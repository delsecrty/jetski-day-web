<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force non-www
  RewriteCond %{HTTP_HOST} ^www\.jetskiday\.day [NC]
  RewriteRule ^(.*)$ https://jetskiday.day/$1 [R=301,L]

  # Serve folder/index.html for clean URLs (drop trailing slash requirement)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>

ErrorDocument 404 /index.html
